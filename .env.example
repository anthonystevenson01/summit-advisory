# OpenRouter
# Required. Every model call goes through OpenRouter (openrouter.ai) from app/lib/llm.ts.
# Set the same key in the Vercel project settings.
OPENROUTER_API_KEY=sk-or-v1-...

# Notion
# Required. One database holds every tool's rubric and system prompt ("Tool Rubrics").
# Rows: icp, persona, problem, positioning, moat, route-to-buyer, unit-of-value, built-to-scale.
# The site reads Status = Published only, server side, from app/lib/rubrics.ts.
# The integration token needs read access to the database.
NOTION_TOKEN=secret_...
NOTION_RUBRICS_DB_ID=dad404fc12af4207bd446e9e8be22330

# Upstash Redis
# Required. Rate limiting, the run store, routing overrides, the call log and the event stream.
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# Vercel KV (alternative to Upstash)
# Used automatically if the UPSTASH_* variables are not set.
KV_REST_API_URL=https://xxxx.kv.vercel-storage.com
KV_REST_API_TOKEN=AXxx...

# SMTP and the daily digest
# Optional. The daily lead report (/api/admin/daily-report) emails NOTIFY_EMAIL via SMTP.
# CRON_SECRET must match the Vercel cron secret so only the cron can call the route.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=...
NOTIFY_EMAIL=you@example.com
CRON_SECRET=...

# Admin
# Google sign-in for /admin. ADMIN_ALLOWED_EMAIL is the one account allowed in.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
ADMIN_ALLOWED_EMAIL=you@example.com

# Newsletter
# Optional. If set, /api/newsletter/signup proxies email signups to this endpoint.
# The endpoint should accept POST { email: string }.
# If not set, the API returns { status: "coming_soon" } gracefully.
NEWSLETTER_ENDPOINT=https://your-email-provider.com/api/subscribe
