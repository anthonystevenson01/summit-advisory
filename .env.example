# OpenRouter
# Required. Every model call goes through OpenRouter (openrouter.ai) from app/lib/llm.ts.
# Set the same key in the Vercel project settings.
OPENROUTER_API_KEY=sk-or-v1-...

# Notion
# Required. One database holds every tool's rubric and system prompt ("Tool Rubrics").
# Rows: icp, persona, problem, positioning, moat, route-to-buyer, unit-of-value, built-to-scale.
# The site reads Status = Published only, server side, from app/lib/rubrics.ts.
# The integration token needs read access to the database.
NOTION_TOKEN=secret_...
NOTION_RUBRICS_DB_ID=dad404fc12af4207bd446e9e8be22330
# The Project Briefs database every saved and submitted Project Builder brief is written to.
# The integration needs insert and update access, not just read. Properties as listed in docs/runbook.md.
# Optional: when unset the builder works and no Notion page is written.
NOTION_BRIEFS_DB_ID=

# Upstash Redis
# Required. Rate limiting, the run store, routing overrides, the call log and the event stream.
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# Vercel KV (alternative to Upstash)
# Used automatically if the UPSTASH_* variables are not set.
KV_REST_API_URL=https://xxxx.kv.vercel-storage.com
KV_REST_API_TOKEN=AXxx...

# SMTP and the daily digest
# Optional. The daily lead report (/api/admin/daily-report) emails NOTIFY_EMAIL via SMTP.
# CRON_SECRET must match the Vercel cron secret so only the cron can call the route.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=...
NOTIFY_EMAIL=you@example.com
CRON_SECRET=...

# Unlock gate and emailed results
# UNLOCK_SECRET is required in production. Generate with: openssl rand -hex 32
# It signs the 30 day unlock cookie, the saved result link and the delete-my-data link.
# Rotating it logs every visitor out and breaks every emailed link.
# When unset, unlocks still work per run, no cookie or result email is sent and the server warns once.
UNLOCK_SECRET=...
# Optional. The From address on the emailed result. Defaults to SMTP_USER.
RESULT_FROM_EMAIL=results@example.com

# Ask Summit to score it (Release 3b)
# BLOB_READ_WRITE_TOKEN is required for uploads: from the Vercel Blob store connected to the project.
# Without it the upload route answers 503 and the form can still be sent without files.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# QStash runs the processing job. From the Upstash QStash console. Without QSTASH_TOKEN a request is
# stored as queued with "needs Process now" (the admin queue, or npm run process-ask -- {id}); without the
# signing keys the processing route answers 503 and never processes an unsigned call.
QSTASH_TOKEN=...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...
# Optional. The crawler's user agent. Default: SummitBot/1.0 (+https://summitstrategyadvisory.com/tools/ask-summit)
ASK_SUMMIT_USER_AGENT=
# Optional. Lets QStash reach a deployment behind Vercel's protection (sent as x-vercel-protection-bypass).
VERCEL_AUTOMATION_BYPASS_SECRET=
# Reused by Ask Summit: NOTIFY_EMAIL and the SMTP variables (the confirmation and the alerts to Anthony),
# UNLOCK_SECRET (the delete-my-data link in the confirmation) and CRON_SECRET (the daily retention cron).

# Admin
# Google sign-in for /admin. ADMIN_ALLOWED_EMAIL is the one account allowed in.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
ADMIN_ALLOWED_EMAIL=you@example.com

# Newsletter
# Optional. If set, /api/newsletter/signup proxies email signups to this endpoint.
# The endpoint should accept POST { email: string }.
# If not set, the API returns { status: "coming_soon" } gracefully.
NEWSLETTER_ENDPOINT=https://your-email-provider.com/api/subscribe
